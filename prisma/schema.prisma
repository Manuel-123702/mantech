// MANTECH Nexus Enterprise Prisma Schema
// Target Architecture: Next.js + TypeScript + Clerk + PostgreSQL (Neon) + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------

enum UserRole {
  INTERN
  COMPANY
  UNIVERSITY
  ADMIN
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ModerationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  SUSPENDED
  EXPIRED
  ARCHIVED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  PLACEMENT_PENDING
  PLACED
  INTERNSHIP_ACTIVE
  COMPLETED
  REJECTED
  WITHDRAWN
  ARCHIVED
  CANCELLED
}

enum PlacementStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationMethod {
  MANTECH
  COMPANY_WEBSITE
  EXTERNAL
}

enum PackageCode {
  FREE
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

// ------------------------------------------------------------------------
// USER & IDENTITY (Clerk Anchor)
// ------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  clerkId        String    @unique
  email          String    @unique
  fullName       String
  avatarUrl      String?
  role           UserRole  @default(INTERN)
  subRole        String?
  phone          String?
  bio            String?
  status         String    @default("active") // active, suspended, pending
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Growth: referral loop. Every user can have one shareable code; joining
  // through /sign-up?ref=CODE records who invited the new member.
  referralCode   String?   @unique
  referredById   String?
  referredBy     User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers  User[]    @relation("UserReferrals")

  internProfile      InternProfile?
  organizationMembers OrganizationMember[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  savedOpportunities SavedOpportunity[]
  candidateApplications CandidateApplication[]
  candidateAlerts    CandidateAlert?
  reportsFiled       Report[]    @relation("ReportReporter")
  boostRequests      Boost[]     @relation("BoostRequester")

  @@index([email])
  @@index([clerkId])
  @@index([role])
  @@index([referredById])
}

// ------------------------------------------------------------------------
// INTERN PROFILE & INTERN PASSPORT (SRS Section 6 & 7)
// ------------------------------------------------------------------------

model InternProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String    // Mandatory during registration
  isPhonePublic      Boolean   @default(false) // Privacy control (verified orgs only)
  qualification      String    // Mandatory during registration (Diploma/degree obtained)
  academicLevel      String?   // HND, BSc, MSc, Engineering Cycle
  institution        String?
  fieldOfStudyId     String?
  fieldOfStudy       Field?    @relation(fields: [fieldOfStudyId], references: [id])
  specializationId   String?
  specialization     Specialization? @relation(fields: [specializationId], references: [id])
  regionId           String?
  region             Region?   @relation(fields: [regionId], references: [id])
  city               String?
  preferredWorkMode  WorkMode  @default(ONSITE)
  availability       String?   // Immediate, Next Month, Summer 2026
  cvUrl              String    // Mandatory during registration
  cvFileName         String?
  cvFileSize         Int?
  cvUploadedAt       DateTime?
  isCvSearchable     Boolean   @default(true) // Profile discoverability setting
  readinessScore     Int       @default(40)
  profileCompleted   Boolean   @default(false)
  // Career & job-acquisition signals used to increase readiness over time.
  targetRole         String?
  targetIndustries   String?
  careerGoals        String?
  skillsToImprove    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  passport           InternPassport?
  educations         Education[]
  skills             InternProfileSkill[]
  applications       Application[]
  placements         Placement[]
  savedByOrganizations SavedCandidate[]
  contactRequests    CandidateContact[]
  cvFiles            CVFileMetadata[]

  @@index([fieldOfStudyId])
  @@index([regionId])
  @@index([city])
  @@index([isCvSearchable])
}

model InternPassport {
  id                  String        @id @default(uuid())
  internProfileId     String        @unique
  internProfile       InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  passportNumber      String        @unique // e.g. MTN-CM-2026-8941
  headline            String?
  summary             String?
  totalHoursCompleted Int           @default(0)
  isVerified          Boolean       @default(true)
  qrCodeData          String?
  viewCount           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  achievements        PassportAchievement[]
  experiences         PassportExperience[]

  @@index([passportNumber])
}

model PassportAchievement {
  id          String         @id @default(uuid())
  passportId  String
  passport    InternPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  title       String
  category    String         // verified_internship, qualification, certification
  issuer      String
  issueDate   DateTime
  description String?
  badgeColor  String?
}

model PassportExperience {
  id                 String         @id @default(uuid())
  passportId         String
  passport           InternPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  companyName        String
  roleTitle          String
  durationMonths     Int
  location           String
  skillsVerified     String[]       @default([])
  endorsementComment String?
  verifiedAt         DateTime       @default(now())
}

model Education {
  id              String        @id @default(uuid())
  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  institution     String
  qualification   String        // HND, BSc, BEng, Master, etc.
  field           String
  startYear       Int
  endYear         Int?
  isCurrent       Boolean       @default(false)
  grade           String?
  createdAt       DateTime      @default(now())
}

model InternProfileSkill {
  id              String        @id @default(uuid())
  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency     String        @default("intermediate") // beginner, intermediate, advanced

  @@unique([internProfileId, skillId])
}

// ------------------------------------------------------------------------
// TAXONOMY (All Professional Sectors & Cameroon Geography)
// ------------------------------------------------------------------------

model Qualification {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  level       String   // Secondary, Undergraduate, Postgraduate
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  category  String   // Software, Network, Finance, Marketing, Law, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  internSkills InternProfileSkill[]
}

model Field {
  id            String            @id @default(uuid())
  name          String            @unique
  slug          String            @unique
  category      String            // Technology, Business, Engineering, Healthcare, Law
  description   String?
  isCameroonHND Boolean           @default(false)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  specializations Specialization[]
  opportunities   InternshipOpportunity[]
  internProfiles  InternProfile[]
}

model Specialization {
  id          String   @id @default(uuid())
  fieldId     String
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)

  internProfiles InternProfile[]
  opportunities  InternshipOpportunity[]

  @@unique([fieldId, name])
}

model Industry {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizations Organization[]
}

model Region {
  id        String     @id @default(uuid())
  name      String     @unique // Centre, Littoral, South-West, etc.
  code      String     @unique // CM-CE, CM-LT, etc.
  capital   String     // Yaoundé, Douala, Buea
  country   String     @default("Cameroon")
  isActive  Boolean    @default(true)

  locations      Location[]
  internProfiles InternProfile[]
  opportunities  InternshipOpportunity[]
  organizations  Organization[]
}

model Location {
  id        String   @id @default(uuid())
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  city      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([regionId, city])
}

// ------------------------------------------------------------------------
// ORGANIZATIONS (Companies & Universities Dual-Mode)
// ------------------------------------------------------------------------

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  type               OrganizationType   @default(COMPANY)
  industryId         String?
  industry           Industry?          @relation(fields: [industryId], references: [id])
  description        String?
  website            String?
  email              String?
  phone              String?
  logoUrl            String?
  regionId           String?
  region             Region?            @relation(fields: [regionId], references: [id])
  city               String?
  address            String?
  size               String?            // 1-10, 11-50, 51-200, 201-500, 500+
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  packageCode        PackageCode        @default(FREE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members            OrganizationMember[]
  companyProfile     CompanyProfile?
  universityProfile  UniversityProfile?
  verifications      Verification[]
  opportunities      InternshipOpportunity[]
  placements         Placement[]
  savedCandidates    SavedCandidate[]
  candidateContacts  CandidateContact[]
  subscriptions      OrganizationSubscription[]
  boosts             Boost[]

  @@index([slug])
  @@index([type])
  @@index([verificationStatus])
  @@index([regionId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle       String?
  isOwner        Boolean      @default(false)
  role           String       @default("recruiter") // owner, admin, recruiter, member
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
}

model CompanyProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  techStack      String[]     @default([])
  perks          String[]     @default([])
  branches       String[]     @default([])
}

model UniversityProfile {
  id                            String       @id @default(uuid())
  organizationId                String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  universityType                String?      // Public State University, Private Higher Institute, Polytechnic
  canRecruitInterns             Boolean      @default(true)  // Mode B: Recruit Interns
  supportsPlacementCoordination Boolean      @default(true)  // Mode A: Help Find Opportunities
  faculties                     String[]     @default([])
}

model Verification {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         VerificationStatus @default(PENDING)
  documentUrls   String[]           @default([])
  taxIdNumber    String?
  reviewerNote   String?
  reviewedAt     DateTime?
  submittedAt    DateTime           @default(now())
}

// ------------------------------------------------------------------------
// INTERNSHIP OPPORTUNITIES (3 Application Methods)
// ------------------------------------------------------------------------

model InternshipOpportunity {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  slug              String            @unique
  description       String
  department        String?
  fieldId           String?
  field             Field?            @relation(fields: [fieldId], references: [id])
  specializationId  String?
  specialization    Specialization?   @relation(fields: [specializationId], references: [id])
  requiredSkills    String[]          @default([])
  preferredSkills   String[]          @default([])
  educationLevel    String?           // HND, Bachelor, Master
  regionId          String?
  region            Region?           @relation(fields: [regionId], references: [id])
  city              String
  location          String?
  workMode          WorkMode          @default(ONSITE)
  durationMonths    Int               @default(3)
  startDate         DateTime?
  endDate           DateTime?
  deadline          DateTime
  isPaid            Boolean           @default(false)
  allowanceXAF      Int?              @default(0) // Monthly stipend in FCFA
  positions         Int               @default(1)
  applicationMethod ApplicationMethod @default(MANTECH)
  applicationUrl    String?           // For company_website or external
  externalPlatform  String?           // e.g. LinkedIn, Job Portal
  instructions      String?
  contactEmail      String?
  isFeatured        Boolean           @default(false)
  moderationStatus  ModerationStatus  @default(PENDING_REVIEW)
  rejectionReason   String?
  moderatedAt       DateTime?
  viewCount         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applications        Application[]
  candidateApplications CandidateApplication[]
  savedOpportunities  SavedOpportunity[]
  featuredEntry       FeaturedOpportunity?
  boosts              Boost[]

  @@index([slug])
  @@index([organizationId])
  @@index([moderationStatus])
  @@index([workMode])
}

// ------------------------------------------------------------------------
// APPLICATIONS & CANDIDATE LIFECYCLE
// ------------------------------------------------------------------------

model Application {
  id                String            @id @default(uuid())
  internProfileId   String
  internProfile     InternProfile     @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicationMethod ApplicationMethod @default(MANTECH)
  status            ApplicationStatus @default(SUBMITTED)
  coverLetter       String?
  resumeUrl         String?
  readinessScore    Int               @default(0)
  internalNotes     String?           // Private to organization recruiters
  candidateRating   Int?              // 1 to 5 stars
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statusHistory     ApplicationStatusHistory[]
  interviews        Interview[]
  placement         Placement?

  @@unique([internProfileId, opportunityId])
  @@index([opportunityId])
  @@index([internProfileId])
  @@index([status])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  actorName     String?
  createdAt     DateTime          @default(now())
}

model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int         @default(45)
  type            String      @default("online") // online, onsite, phone
  meetingLink     String?     // Google Meet, Zoom, MS Teams
  locationAddress String?     // If on-site
  interviewerName String?
  instructions    String?
  status          String      @default("scheduled") // scheduled, completed, cancelled, rescheduled
  feedbackNotes   String?     // Private recruiter feedback
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ------------------------------------------------------------------------
// PLACEMENTS & ONBOARDING (Recruitment Result)
// ------------------------------------------------------------------------

model Placement {
  id              String          @id @default(uuid())
  applicationId   String          @unique
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  internProfileId String
  internProfile   InternProfile   @relation(fields: [internProfileId], references: [id])
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  department      String?
  status          PlacementStatus @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  objectives      String?
  agreementDocUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  onboardingItems Onboarding[]

  @@index([organizationId])
  @@index([internProfileId])
  @@index([status])
}

model Onboarding {
  id          String    @id @default(uuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isRequired  Boolean   @default(true)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
}

// ------------------------------------------------------------------------
// DISCOVERY, SHORTLISTING & CONTACT PRIVACY
// ------------------------------------------------------------------------

model SavedOpportunity {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  savedAt       DateTime              @default(now())

  @@unique([userId, opportunityId])
}

model SavedCandidate {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  notes           String?
  savedAt         DateTime      @default(now())

  @@unique([organizationId, internProfileId])
}

model CandidateContact {
  id                   String        @id @default(uuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internProfileId      String
  internProfile        InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  message              String
  requestedPhoneAccess Boolean       @default(false)
  requestedCvAccess    Boolean       @default(true)
  status               String        @default("pending") // pending, approved, declined
  createdAt            DateTime      @default(now())

  @@unique([organizationId, internProfileId])
}

model CandidateApplication {
  id                String            @id @default(uuid())
  applicantId       String
  applicant         User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  internshipId      String
  internship        InternshipOpportunity @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status            String            @default("submitted") // submitted, in_review, accepted, rejected, withdrawn, archived
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([applicantId, internshipId])
  @@index([internshipId])
  @@index([status])
}

model CandidateAlert {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   String[] @default([])
  regions      String[] @default([])
  cities       String[] @default([])
  workModes    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

model CVFileMetadata {
  id              String        @id @default(uuid())
  internProfileId String
  internProfile   InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  fileKey         String
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String        @default("application/pdf")
  isSecure        Boolean       @default(true)
  uploadedAt      DateTime      @default(now())
}

// ------------------------------------------------------------------------
// MONETIZATION (Section 16 - WhatsApp Manual Activation)
// ------------------------------------------------------------------------

model Package {
  id                         String      @id @default(uuid())
  name                       String
  code                       PackageCode @unique
  priceXAF                   Int
  opportunityLimit           Int
  candidateSearchLimit       Int
  maxRecruiterAccounts       Int
  featuredOpportunitiesLimit Int
  isFeaturedBadge            Boolean     @default(false)
  prioritySupport            Boolean     @default(false)
  description                String
  features                   String[]    @default([])
  createdAt                  DateTime    @default(now())

  subscriptions              OrganizationSubscription[]
}

model OrganizationSubscription {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageId      String
  package        Package            @relation(fields: [packageId], references: [id])
  status         SubscriptionStatus @default(PENDING_PAYMENT)
  paymentMethod  String             @default("WHATSAPP_MANUAL")
  transactionRef String?
  requestedAt    DateTime           @default(now())
  activatedAt    DateTime?
  expiresAt      DateTime?
  notes          String?
}

model FeaturedOpportunity {
  id            String                @id @default(uuid())
  opportunityId String                @unique
  opportunity   InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  startsAt      DateTime              @default(now())
  endsAt        DateTime
  priorityOrder Int                   @default(1)
  isActive      Boolean               @default(true)
}
// What people say about MANTECH, sent in by visitors.
//
// Everything is required except the photo, which is a nice-to-have. These
// fields match the shape of a testimonial we have always wanted to collect:
// who they are, what they do, where they are, what they used MANTECH for, a
// short quote for the card, and the fuller story behind it.
model Testimonial {
  id      String @id @default(uuid())
  name    String
  email   String
  role    String
  company String
  region  String
  focus   String
  message String @db.Text
  details String @db.Text
  rating  Int    @default(5)
  // The only optional part.
  photoUrl    String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  @@index([status, createdAt])
  @@index([role])
  @@index([focus])
}

// ------------------------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// ------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String   // application, interview, placement, shortlist, contact, system
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  String?
  action     String   // CV_VIEWED, CANDIDATE_SHORTLISTED, OPPORTUNITY_MODERATED, etc.
  entityType String
  entityId   String
  details    String?  // JSON details
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
}

// Two-factor gate for the admin dashboard (SRS security hardening).
// After the normal Clerk email+password sign-in, a 6-digit code is generated
// server-side, hashed at rest, and delivered to the admin's WhatsApp number.
// Only the SHA-256 hash is stored — the plaintext code never touches the DB.
model AdminOtp {
  id         String    @id @default(uuid())
  email      String    // lowercased admin email the code was issued for
  codeHash   String    // SHA-256(pepper || email || code)
  expiresAt  DateTime // issue time + 60 seconds
  attempts   Int       @default(0) // failed verify attempts, max 3
  consumedAt DateTime? // set when verified, burned, or superseded
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Moderation reports (trust & safety).
//
// Signed-in members flag content they believe is scammy, misleading or
// inappropriate; national admins review the queue and act (suspend/reject
// through the existing moderation tools) or dismiss. Distinct from the
// deprecated academic reports API (app/api/reports -> 410 Gone).
// ---------------------------------------------------------------------------

enum ReportTargetType {
  OPPORTUNITY // an internship posting (targetId = InternshipOpportunity.id)
  PASSPORT // a public intern passport (targetId = InternProfile.id)
}

enum ReportReason {
  SCAM // fake internship, asks for money, phishing
  MISLEADING // description does not match the actual role
  SPAM // duplicate or low-effort posting
  INAPPROPRIATE // offensive or discriminatory content
  OTHER // anything else (details expected)
}

enum ReportStatus {
  OPEN // filed, waiting for an admin
  REVIEWING // an admin picked it up
  ACTIONED // admin acted on the reported content
  DISMISSED // reviewed, no action needed
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String // id of the reported opportunity / passport
  targetTitle  String // snapshot at report time (survives deletion)
  reason       ReportReason
  details      String? // free text from the reporter
  status       ReportStatus     @default(OPEN)
  resolution   String? // admin note explaining the decision
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // One open report per member per target — filing twice just re-files the
  // same case, so the unique key turns it into a no-op instead.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Boosts — paid/organic visibility boosts for published opportunities.
//
// Flow: a company requests a boost for one of its PUBLISHED opportunities,
// an admin approves (or rejects with a note). Approval flips the existing
// isFeatured/FeaturedOpportunity machinery — the same one the admin feature
// route uses — so boosted opportunities sort first in listings
// (orderBy isFeatured desc in /api/internships and /api/candidates/check).
// When endsAt passes the boost expires and the feature flag is switched off.
// ---------------------------------------------------------------------------

enum BoostStatus {
  REQUESTED // waiting for admin review
  APPROVED // active window running (isFeatured = true)
  REJECTED // admin declined (resolution holds the reason)
  EXPIRED // window elapsed, feature flag switched off
}

model Boost {
  id             String           @id @default(cuid())
  opportunityId  String
  opportunity    InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User             @relation("BoostRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  status         BoostStatus      @default(REQUESTED)
  days           Int              // requested boost length in days (1-90)
  note           String? // optional message from the company
  resolution     String? // admin decision note
  startsAt       DateTime? // set on approval
  endsAt         DateTime? // set on approval (startsAt + days)
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // At most one live request per opportunity; approvals create history rows
  // only after the previous one is terminal (rejected/expired), enforced in
  // lib/boosts.ts rather than a partial unique index (Neon supports it but
  // Prisma cannot express it portably).
  @@index([status, createdAt])
  @@index([organizationId])
  @@index([opportunityId])
}
