{
  "presets": [
    [
      "next/babel",
      {
        "preset-env": {
          "exclude": ["transform-unicode-regex"],
          "targets": {
            "chrome": "64",
            "edge": "79",
            "firefox": "78",
            "ios": "11.3",
            "safari": "11.1"
          }
        }
      }
    ]
  ],
  "plugins": ["@lingui/babel-plugin-lingui-macro"]
}
